#include <iostream>
using namespace std;

int main() {
    double sales = 0, total = 0, average;
    int customers = 0;

    cout << " Enter sales amount (0 to stop): ";
    cin >> sales;

    while (sales != 0) {
       total = total + sales;
       customers++;

       cout << "Enter sales amount (0 to stop); ";
       cin >> sales;
    }

    if (customers > 0) {
        average = total /customers;
    }

    cout << "\Number of customers: " << customers;
    cout << "\Total sales collected: " << total;
    cout << "\nAverage sales per customers: " << average;

    return 0;

}
